{
  "name": "@akihunter/dsh-livingemotion",
  "version": "0.1.0-alpha.1",
  "description": "LivingEmotion native DSH adapter with the original Python emotion core",
  "type": "module",
  "main": "dsh/index.mjs",
  "exports": "./dsh/index.mjs",
  "engines": { "node": ">=22.19" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "files": ["dsh", "cordis.patch.yml", "contracts.py", "prompt_precision.py", "domain/__init__.py", "domain/emotion.py", "domain/relationship.py", "domain/appraisal.py", "__init__.py", "docs/DSH.md", "tests/dsh", "LICENSE"],
