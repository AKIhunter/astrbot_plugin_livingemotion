{
  "enabled": {"type": "bool", "default": true, "description": "Enable local state processing"},
  "mode": {"type": "string", "default": "active", "options": ["active", "observe_only"], "description": "Operating mode"},
  "memory_mode": {"type": "string", "default": "none", "options": ["none", "local_lite", "external"], "description": "Optional long-term memory"},
  "memory_read": {"type": "bool", "default": false, "description": "Allow external memory reads"},
  "memory_export": {"type": "bool", "default": false, "description": "Allow explicit experience export"},
  "autonomy_enabled": {"type": "bool", "default": false, "description": "Allow autonomous behavior"},
  "group_autonomy_enabled": {"type": "bool", "default": false, "description": "Allow group autonomous behavior"},
  "emotion_model_enabled": {"type": "bool", "default": false, "description": "Allow paid emotion refinement"},
  "dream_enabled": {"type": "bool", "default": false, "description": "Allow dream generation"},
  "diary_enabled": {"type": "bool", "default": false, "description": "Allow diary generation"},
  "night_enabled": {"type": "bool", "default": true, "description": "Enable local night state"},
  "night_block_chat": {"type": "bool", "default": false, "description": "Explicitly allow night state to block ordinary chat"},
  "persona_mode": {"type": "string", "default": "follow", "options": ["follow", "explicit", "none"], "description": "Native persona selection"},
  "persona_id": {"type": "string", "default": "", "description": "Explicit native persona ID"},
  "timezone": {"type": "string", "default": "", "description": "IANA timezone, required for autonomous scheduling"},
  "provider_id": {"type": "string", "default": "", "description": "Background provider; empty follows current session"},
  "fallback_provider_id": {"type": "string", "default": "", "description": "Fallback only before dispatch, never retry an unknown request"},
  "autonomy_scopes": {"type": "string", "default": "", "description": "Whitespace-separated full scope keys; empty denies all"},
  "muted_scopes": {"type": "string", "default": "", "description": "Whitespace-separated muted scope keys"},
  "night_schedule_enabled": {"type": "bool", "default": false, "description": "Enable planned sleep windows"},
  "sleep_at": {"type": "string", "default": "01:00", "description": "Local sleep time HH:MM"},
  "wake_at": {"type": "string", "default": "08:00", "description": "Local wake time HH:MM"},
  "diary_at": {"type": "string", "default": "23:00", "description": "Local diary time HH:MM"},
  "diary_backfill_yesterday": {"type": "bool", "default": false, "description": "Allow only yesterday diary backfill"},
  "scheduler_seconds": {"type": "int", "default": 60, "description": "Local scheduler interval, no default model calls"},
  "dnd_start": {"type": "string", "default": "01:00", "description": "Autonomy do-not-disturb start HH:MM"},
  "dnd_end": {"type": "string", "default": "08:00", "description": "Autonomy do-not-disturb end HH:MM"},
  "active_start": {"type": "string", "default": "00:00", "description": "Autonomy active window start HH:MM"},
  "active_end": {"type": "string", "default": "23:59", "description": "Autonomy active window end HH:MM (exclusive)"},
  "behavior_daily_limit": {"type": "int", "default": 6, "description": "Global daily autonomous attempts"},
  "behavior_scope_daily_limit": {"type": "int", "default": 2, "description": "Daily autonomous attempts per source scope"},
  "behavior_cooldown_seconds": {"type": "int", "default": 7200, "description": "Autonomous attempt cooldown"},
  "behavior_unanswered_limit": {"type": "int", "default": 2, "description": "Stop after this many unanswered confirmed or unknown sends"},
  "diary_retries": {"type": "int", "default": 2, "description": "Diary retry limit (0..2); all attempts consume budget"},
  "dream_per_night": {"type": "int", "default": 2, "description": "Dream attempt limit per sleep episode (1..2)"},
  "diary_retention_days": {"type": "int", "default": 30, "description": "Unpinned diary retention (1..365 days)"},
  "dream_retention_days": {"type": "int", "default": 7, "description": "Unpinned dream retention (1..30 days)"},
  "dream_half_life_seconds": {"type": "int", "default": 86400, "description": "Dream clarity half-life"},
  "experience_body_chars": {"type": "int", "default": 2000, "description": "Maximum experience body characters"},
  "model_concurrency": {"type": "int", "default": 1, "description": "Background worker limit (1..8)"},
  "queue_size": {"type": "int", "default": 100, "description": "Bounded background queue (1..1000)"},
  "model_daily_limit": {"type": "int", "default": 48, "description": "Global daily model reservations"},
  "emotion_interval_seconds": {"type": "int", "default": 300, "description": "Minimum refinement interval per scope"},
  "model_input_tokens": {"type": "int", "default": 4096, "description": "Maximum input tokens per model task"},
  "model_output_tokens": {"type": "int", "default": 1024, "description": "Maximum requested output tokens"},
  "model_timeout_seconds": {"type": "int", "default": 30, "description": "Background task timeout"},
  "window_days": {"type": "int", "default": 7, "description": "Body retention days (1..7)"},
  "window_per_scope": {"type": "int", "default": 200, "description": "Body records per scope (1..200)"},
  "window_global": {"type": "int", "default": 10000, "description": "Total body records (1..10000)"},
  "body_max_chars": {"type": "int", "default": 8000, "description": "Body characters per record (1..8000)"},
  "event_days": {"type": "int", "default": 30, "description": "Non-body event retention days"},
  "persona_shared_state": {"type": "bool", "default": true, "description": "Share numeric emotion and night state within one instance/persona; old missing setting keeps scene mode"},
  "night_policy_version": {"type": "int", "default": 2, "description": "2 enables five-state rules after timezone setup; old missing field stays 1"},
  "allow_sleep": {"type": "bool", "default": true, "description": "Policy 2: allow sleep to block chat; off keeps energy tracking"},
  "nap_enabled": {"type": "bool", "default": true, "description": "Policy 2: enable afternoon nap"},
  "nap_start": {"type": "string", "default": "13:00", "description": "Nap start HH:MM"},
  "nap_end": {"type": "string", "default": "14:30", "description": "Nap end HH:MM"},
  "fatigue_start": {"type": "string", "default": "23:30", "description": "Night fatigue/sleep cycle start HH:MM"},
  "fatigue_end": {"type": "string", "default": "07:00", "description": "Fatigue drain end, not permission to exit deep sleep"},
  "deep_sleep_at": {"type": "string", "default": "02:30", "description": "Deep sleep HH:MM; drowsy starts at the start/deep midpoint"},
  "lie_in_min_minutes": {"type": "int", "default": 0, "description": "Minimum nonnegative lie-in minutes"},
  "lie_in_max_minutes": {"type": "int", "default": 90, "description": "Maximum lie-in minutes; one durable draw per night"},
  "wake_mode": {"type": "string", "default": "chat", "options": ["chat", "never", "both"], "description": "Private human wake; never; or private/native group mention"},
  "wake_reply_limit": {"type": "int", "default": 3, "description": "Generation attempts allowed after chat wake; failures count"},
  "wake_window_minutes": {"type": "int", "default": 10, "description": "Absolute wake window from first host submission"},
  "energy_reply_cost": {"type": "float", "default": 4.0, "description": "Energy cost once per visible reply; fixed step 0.1"},
  "energy_fatigue_per_minute": {"type": "float", "default": 0.8, "description": "Awake fatigue drain per minute; fixed step 0.1"},
  "energy_recovery_per_minute": {"type": "float", "default": 1.5, "description": "Sleep/non-fatigue recovery per minute; fixed step 0.1"},
  "catchup_enabled": {"type": "bool", "default": true, "description": "Read archived unread messages after waking"},
  "catchup_reply_enabled": {"type": "bool", "default": true, "description": "Generate bounded historical replies after reading"},
  "closing_enabled": {"type": "bool", "default": false, "description": "Allow bedtime closing in recently participating real scenes"},
  "closing_random": {"type": "bool", "default": false, "description": "Use one budgeted generation for closing instead of local template"},
  "closing_lead_minutes": {"type": "int", "default": 5, "description": "Closing lead before night fatigue start"},
  "diary_provider_id": {"type": "string", "default": "", "description": "Diary provider; empty follows chat"},
  "dream_provider_id": {"type": "string", "default": "", "description": "Dream provider; empty follows chat"},
  "catchup_provider_id": {"type": "string", "default": "", "description": "Catchup provider; empty follows chat"},
  "closing_provider_id": {"type": "string", "default": "", "description": "Closing provider; empty follows chat"},
  "home_city": {"type": "string", "default": "", "description": "Bot home city for weather"},
  "embedding_provider_id": {"type": "string", "default": "", "description": "Native embedding provider ID; no credentials"},
  "livingmemory_enabled": {"type": "bool", "default": false, "description": "Use installed LivingMemory public facade instead of local vectors"},
  "memory_write": {"type": "bool", "default": false, "description": "Allow local automatic vector collection"}
}
